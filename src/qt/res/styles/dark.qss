/* ================================================================
   MTBC WALLET — CHARCOAL THEME
   Dark grey base  ·  Electric blue accent  ·  White icons
   Inspired by Dash Core / MetaMask 2025 aesthetic
   ================================================================ */

/* ---- BASE ---- */
QWidget {
    background-color: #1a1a1a;
    color: #f0f0f0;
    border: none;
}

QMainWindow {
    background-color: #141414;
}

/* ---- MENU BAR ---- */
QMenuBar {
    background-color: #111111;
    color: #aaaaaa;
    border-bottom: 1px solid #2a2a2a;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected, QMenuBar::item:pressed {
    background: rgba(0, 153, 255, 0.15);
    color: #0099ff;
}

QMenu {
    background-color: #202020;
    color: #e0e0e0;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 5px 3px;
}

QMenu::item {
    padding: 8px 28px 8px 14px;
    border-radius: 5px;
    margin: 1px 4px;
}

QMenu::item:selected {
    background: rgba(0, 153, 255, 0.18);
    color: #4db8ff;
}

QMenu::separator {
    height: 1px;
    background: #333333;
    margin: 4px 10px;
}

/* ---- TOOLBAR (tab navigation) ---- */
QToolBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #1e1e1e, stop:1 #181818);
    border-bottom: 1px solid #0099ff;
    padding: 4px 10px;
    spacing: 2px;
    min-height: 48px;
}

QToolBar::separator {
    background: #333333;
    width: 1px;
    margin: 8px 6px;
}

QToolButton {
    background: transparent;
    color: #777777;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
    margin: 2px 2px;
    min-width: 80px;
}

QToolButton:hover {
    background: rgba(0, 153, 255, 0.10);
    color: #cccccc;
    border: 1px solid rgba(0, 153, 255, 0.25);
}

QToolButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0077cc, stop:1 #005fa3);
    color: #ffffff;
    border: 1px solid #0099ff;
    font-weight: 700;
}

QToolButton:pressed {
    background: #004f88;
    color: #ffffff;
}

QToolBar QLabel {
    color: #666666;
    font-size: 12px;
    padding-right: 4px;
}

QToolBar QComboBox {
    background: #252525;
    color: #aaaaaa;
    border: 1px solid #383838;
    border-radius: 6px;
    padding: 4px 10px;
}

QToolBar QComboBox:hover {
    border-color: #0099ff;
    color: #e0e0e0;
}

/* ---- FRAMES / CARDS ---- */
QFrame {
    background: transparent;
    border: none;
}

QFrame[frameShape="6"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #222222, stop:1 #1e1e1e);
    border: 1px solid #2e2e2e;
    border-radius: 10px;
}

QFrame[frameShape="HLine"] {
    background: transparent;
    border: none;
    border-top: 1px solid #2a2a2a;
    max-height: 1px;
}

QFrame[frameShape="VLine"] {
    background: transparent;
    border: none;
    border-left: 1px solid #2a2a2a;
    max-width: 1px;
}

/* ---- LABELS ---- */
QLabel {
    color: #cccccc;
    background: transparent;
}

QLabel[text="Balances"],
QLabel[text="Recent transactions"] {
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.2px;
}

QLabel#labelBalance,
QLabel#labelTotal,
QLabel#priceData {
    color: #0099ff;
    font-size: 14px;
    font-weight: 700;
}

QLabel#labelUnconfirmed,
QLabel#labelImmature {
    color: #888888;
    font-weight: 500;
}

QLabel#labelStakingRewards {
    color: #00d68f;
    font-weight: 700;
}

QLabel#labelTotalUSD {
    color: #aaaaaa;
}

QLabel#labelAlerts {
    background: #2a1500;
    color: #ffaa44;
    border: 1px solid #664400;
    border-radius: 6px;
    padding: 7px 14px;
}

QLabel#AnnouncementData {
    background: #0d1e33;
    color: #4db8ff;
    border: 1px solid #1a4466;
    border-radius: 6px;
    padding: 7px 14px;
}

/* ---- PUSH BUTTONS ---- */
QPushButton {
    background: #252525;
    color: #0099ff;
    border: 1px solid #0099ff;
    border-radius: 6px;
    padding: 8px 22px;
    font-weight: 600;
    font-size: 13px;
    min-height: 28px;
    outline: none;
}

QPushButton:hover {
    background: #1a3a55;
    border-color: #33bbff;
    color: #33bbff;
}

QPushButton:pressed {
    background: #0d2233;
    border-color: #0077cc;
    color: #0077cc;
}

QPushButton:disabled {
    background: #1e1e1e;
    border-color: #2d2d2d;
    color: #444444;
}

QPushButton:default {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0099ff, stop:1 #0077cc);
    color: #ffffff;
    border: none;
    font-weight: 700;
}

QPushButton:default:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #33bbff, stop:1 #0099ff);
    color: #ffffff;
}

QPushButton#clearButton, QPushButton#deleteButton {
    background: rgba(255, 50, 80, 0.10);
    border-color: rgba(255, 50, 80, 0.45);
    color: #ff5566;
}

QPushButton#clearButton:hover, QPushButton#deleteButton:hover {
    background: rgba(255, 50, 80, 0.22);
    border-color: #ff3344;
    color: #ff7788;
}

/* ---- INPUTS ---- */
QLineEdit, QTextEdit, QPlainTextEdit {
    background: #141414;
    color: #f0f0f0;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 7px 12px;
    selection-background-color: rgba(0, 153, 255, 0.28);
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #0099ff;
    background: #171717;
}

QLineEdit:read-only {
    background: #111111;
    color: #666666;
    border-color: #222222;
}

QLineEdit:disabled, QTextEdit:disabled {
    background: #111111;
    color: #444444;
    border-color: #1e1e1e;
}

/* ---- COMBO BOX ---- */
QComboBox {
    background: #1e1e1e;
    color: #cccccc;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 6px 12px;
    min-width: 80px;
}

QComboBox:hover { border-color: #0099ff; color: #f0f0f0; }
QComboBox:focus { border-color: #0099ff; }

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: url(:/icons/prompticon);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background: #202020;
    color: #cccccc;
    border: 1px solid #333333;
    border-radius: 6px;
    selection-background-color: rgba(0, 153, 255, 0.18);
    selection-color: #4db8ff;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 7px 12px;
    border-radius: 4px;
    min-height: 26px;
}

/* ---- SPIN BOX ---- */
QSpinBox, QDoubleSpinBox {
    background: #141414;
    color: #f0f0f0;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 6px 8px;
}

QSpinBox:focus, QDoubleSpinBox:focus { border-color: #0099ff; }

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: #252525;
    border: none;
    width: 20px;
    border-radius: 3px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: #333333;
}

/* ---- CHECK BOX & RADIO ---- */
QCheckBox, QRadioButton {
    color: #cccccc;
    spacing: 8px;
    background: transparent;
}

QCheckBox:hover, QRadioButton:hover { color: #f0f0f0; }

QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border: 2px solid #444444;
    border-radius: 4px;
    background: #141414;
}

QCheckBox::indicator:checked {
    background: #0099ff;
    border-color: #0099ff;
}

QCheckBox::indicator:hover { border-color: #0099ff; }

QRadioButton::indicator {
    width: 17px;
    height: 17px;
    border: 2px solid #444444;
    border-radius: 9px;
    background: #141414;
}

QRadioButton::indicator:checked {
    background: #0099ff;
    border-color: #0099ff;
}

QRadioButton::indicator:hover { border-color: #0099ff; }

/* ---- TABLES / LISTS ---- */
QTableView, QListView, QTreeView {
    background: #161616;
    alternate-background-color: #1a1a1a;
    color: #cccccc;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    gridline-color: #222222;
    selection-background-color: rgba(0, 153, 255, 0.15);
    selection-color: #ffffff;
    outline: none;
}

QTableView::item, QListView::item, QTreeView::item {
    padding: 6px 10px;
    border: none;
}

QTableView::item:hover, QListView::item:hover, QTreeView::item:hover {
    background: rgba(0, 153, 255, 0.07);
    color: #f0f0f0;
}

QTableView::item:selected, QListView::item:selected, QTreeView::item:selected {
    background: rgba(0, 153, 255, 0.18);
    color: #ffffff;
}

/* ---- HEADER VIEW ---- */
QHeaderView { background: transparent; border: none; }

QHeaderView::section {
    background: #1e1e1e;
    color: #666666;
    border: none;
    border-right: 1px solid #2a2a2a;
    border-bottom: 1px solid #2a2a2a;
    padding: 8px 12px;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

QHeaderView::section:hover { color: #0099ff; background: #202020; }
QHeaderView::section:first { border-top-left-radius: 8px; }
QHeaderView::section:last  { border-right: none; border-top-right-radius: 8px; }

/* ---- SCROLLBARS ---- */
QScrollBar:vertical {
    background: transparent;
    width: 7px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #333333;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover  { background: #0099ff; }
QScrollBar::handle:vertical:pressed { background: #33bbff; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    height: 0; background: none; border: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 7px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #333333;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover  { background: #0099ff; }
QScrollBar::handle:horizontal:pressed { background: #33bbff; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    width: 0; background: none; border: none;
}

/* ---- PROGRESS BAR ---- */
QProgressBar {
    background: #141414;
    border: 1px solid #2a2a2a;
    border-radius: 5px;
    text-align: center;
    color: #666666;
    font-size: 11px;
    font-weight: 700;
    max-height: 14px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0055aa, stop:0.6 #0099ff, stop:1 #33ccff);
    border-radius: 4px;
}

/* ---- STATUS BAR ---- */
QStatusBar {
    background: #111111;
    color: #555555;
    border-top: 1px solid #222222;
    font-size: 11px;
}

QStatusBar::item { border: none; }
QStatusBar QLabel { color: #555555; font-size: 11px; }

/* ---- GROUP BOX ---- */
QGroupBox {
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    margin-top: 18px;
    padding: 14px 8px 8px 8px;
    color: #66bbff;
    font-weight: 600;
    font-size: 11px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
}

/* ---- TABS ---- */
QTabWidget::pane {
    border: 1px solid #2a2a2a;
    border-radius: 0 8px 8px 8px;
    background: #1e1e1e;
    top: -1px;
}

QTabBar::tab {
    background: #161616;
    color: #555555;
    border: 1px solid #2a2a2a;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    padding: 8px 20px;
    margin-right: 2px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background: #1e1e1e;
    color: #0099ff;
    border-color: #333333;
    border-bottom: 1px solid #1e1e1e;
    font-weight: 700;
}

QTabBar::tab:hover:!selected {
    color: #aaaaaa;
    background: #1a1a1a;
}

/* ---- TOOLTIP ---- */
QToolTip {
    background: #202020;
    color: #e0e0e0;
    border: 1px solid #383838;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
}

/* ---- SPLITTER ---- */
QSplitter::handle { background: #222222; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical   { height: 1px; }

/* ---- MISC ---- */
QAbstractScrollArea, QAbstractScrollArea > QWidget {
    background: transparent;
}

QStackedWidget { background: #1a1a1a; }

QDialog { background: #1e1e1e; }

QDialogButtonBox QPushButton { min-width: 90px; }
